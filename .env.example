# Jason-hub 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env && vim .env

# MySQL
MYSQL_ROOT_PW=your_secure_password

# Redis
REDIS_PW=your_secure_password

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PW=your_secure_password

# 注意：以下连接串由 docker-compose.yml 注入到容器内使用，
# 主机名必须写 compose 服务名（mysql / redis），写 127.0.0.1 会指向容器自身而连不上。
# Auth 鉴权服务
AUTH_DB_CONNECTION=Server=mysql;Port=3306;Database=jason_auth;User=root;Password=<pw>;
# 初始超级管理员密码（首次启动且 admin 不存在时自动创建；创建后此变量可移除）
AUTH_ADMIN_PASSWORD=

# Monitor 子项目
MONITOR_DB_CONNECTION=Server=mysql;Port=3306;Database=jason_monitor;User=root;Password=<pw>;
MONITOR_REDIS_CONNECTION=redis:6379,password=<redis_pw>
